# Konfigurasi Backend FastAPI
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
PROCESS_TIMEOUT_SECONDS=600

# Path kustom jika repository AutoComment_Python diletakkan di tempat berbeda
# AUTOCOMMENT_REPO_DIR=/path/to/AutoComment_Python

# Gemini API Key untuk bot comment AI
GEMINI_API_KEY=your_gemini_api_key_here

# Target Post Facebook default (opsional)
FB_POST_URLS=https://www.facebook.com/your_post_url_here
